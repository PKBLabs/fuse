OUTPUT_DIRECTORY       = docs/generated
INPUT                  = fuse/app fuse/core fuse/plugin_api fuse/plugins/community/sst fuse/plugins/community/gem5
RECURSIVE              = YES
FILE_PATTERNS          = *.py
EXCLUDE_PATTERNS       = */__pycache__/* */tests/* */.venv/* */build/* */dist/*
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
EXTRACT_ALL            = YES
