{
  "schema_version": 1,
  "sst_version": "16.0.0",
  "description": "FUSE SST runtime overlay for slots/logical ports that are loaded by runtime code but are not fully declared by sst-info metadata.",
  "manual_resolutions": [
    {
      "owner_class": "CarcosaCPUBase",
      "slot_name": "memory",
      "resolution": "declared_by_concrete_types",
      "requires_overlay": false,
      "component_types": [
        "carcosa.CarcosaCPU",
        "carcosa.FaultInjCPU"
      ],
      "rationale": "CarcosaCPUBase is not a user-placeable SST element. Its concrete CPU components declare the memory StandardMem slot through ELI, so the slot belongs in sst-info/catalog metadata rather than the runtime overlay."
    },
    {
      "owner_class": "CoherenceController",
      "slot_name": "hash",
      "resolution": "declared_by_concrete_types",
      "requires_overlay": false,
      "component_types": [
        "memHierarchy.MESI_L1",
        "memHierarchy.MESI_Inclusive",
        "memHierarchy.MESI_Private_Noninclusive",
        "memHierarchy.MESI_Shared_Noninclusive",
        "memHierarchy.Incoherent",
        "memHierarchy.Incoherent_L1"
      ],
      "rationale": "CoherenceController is a base implementation class. Concrete coherence-manager subcomponents declare the hash slot, and the runtime also has anonymous hash-function fallbacks."
    },
    {
      "owner_class": "RoCCAnalog",
      "slot_name": "array",
      "resolution": "declared_by_concrete_types",
      "requires_overlay": false,
      "component_types": [
        "golem.RoCCAnalogInt",
        "golem.RoCCAnalogFloat"
      ],
      "rationale": "RoCCAnalog is a templated/base implementation. The concrete Golem RoCCAnalog subcomponents declare array through ELI."
    },
    {
      "owner_class": "RoCCAnalog",
      "slot_name": "memory_interface",
      "resolution": "declared_by_concrete_types",
      "requires_overlay": false,
      "component_types": [
        "golem.RoCCAnalogInt",
        "golem.RoCCAnalogFloat"
      ],
      "rationale": "RoCCAnalog is a templated/base implementation. The concrete Golem RoCCAnalog subcomponents declare memory_interface through ELI."
    },
    {
      "owner_class": "ScratchBackendConvertor",
      "slot_name": "backend",
      "resolution": "declared_by_concrete_types",
      "requires_overlay": false,
      "component_types": [
        "memHierarchy.simpleMemScratchBackendConvertor"
      ],
      "rationale": "ScratchBackendConvertor is an API/base implementation. The concrete simpleMemScratchBackendConvertor declares the backend slot through ELI."
    },
    {
      "owner_class": "VanadisDecoder",
      "slot_name": "branch_unit",
      "resolution": "declared_by_concrete_types",
      "requires_overlay": false,
      "component_types": [
        "vanadis.VanadisMIPSDecoder",
        "vanadis.VanadisRISCV64Decoder"
      ],
      "rationale": "VanadisDecoder is a base decoder class. The concrete Vanadis MIPS and RISCV64 decoders inherit and expose branch_unit through ELI in SST 16.0.0 catalogs."
    },
    {
      "owner_class": "VanadisDecoder",
      "slot_name": "os_handler",
      "resolution": "declared_by_concrete_types",
      "requires_overlay": false,
      "component_types": [
        "vanadis.VanadisMIPSDecoder",
