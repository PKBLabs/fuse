[run]
branch = True
source =
    fuse/core
    fuse/app
    fuse/plugins/community/sst

omit =
    */tests/*
    */.venv/*
    */__pycache__/*

[report]
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
    if TYPE_CHECKING:
